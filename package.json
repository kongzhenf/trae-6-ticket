{
  "name": "trae-6",
  "private": true,
  "version": "0.0.0",
  "description": "演唱会票务平台 monorepo（H5 + 管理后台）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/build.sh",
    "typecheck": "bash scripts/typecheck.sh",
    "lint": "bash scripts/lint.sh",
    "format": "bash scripts/format.sh",
    "format:check": "bash scripts/format.sh check",
    "clean": "bash scripts/clean.sh",
    "dev:h5": "bash scripts/dev.sh h5",
    "dev:admin": "bash scripts/dev.sh admin",
    "build:h5": "bash scripts/build.sh h5",
    "build:admin": "bash scripts/build.sh admin",
    "preview:h5": "cd apps/h5 && ../../node_modules/.bin/vite preview",
    "preview:admin": "cd apps/admin && ../../node_modules/.bin/vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^7.0.0"
  }
}
