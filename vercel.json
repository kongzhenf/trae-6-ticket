{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".vercel/output",
  "buildCommand": "sh scripts/build-vercel.sh",
  "installCommand": "npm install --no-audit --no-fund",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin/login",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/concerts",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/concerts/:id/edit",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/concerts/:id/tickets",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/orders",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/users",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/users/viewers",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/exports",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin/|favicon\\.svg|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}